# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Port the backend listens on
PORT=8080

# Path to your Google Cloud service account JSON key file.
# This account needs the Speech-to-Text, Cloud Translation, and Text-to-Speech APIs enabled.
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# Allowed origin for CORS (your frontend's URL). Use * only for local development.
CORS_ORIGIN=http://localhost:8080
